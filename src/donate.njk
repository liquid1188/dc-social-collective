---
layout: base.njk
title: Donate
permalink: /donate/
description: "Support DC Social Collective."
---
<div class="wrap page-head">
  <h1>{{ donate.heading }}</h1>
  <p class="lede">{{ donate.lede }}</p>
</div>
<section class="band" style="padding-top:1.5rem">
  <div class="wrap two-col">
    <div>
      <p>{{ donate.body }}</p>
      <p style="margin:1.4rem 0 .8rem"><a class="btn" href="{{ site.donate }}" target="_blank" rel="noopener">{{ donate.button }}</a></p>
      <p class="tally">{{ donate.note }}</p>
      <p>{{ donate.thanks }}</p>
    </div>
    <img src="/images/gallery/18.jpg" alt="Friends at a summer soiree" loading="lazy">
  </div>
</section>
