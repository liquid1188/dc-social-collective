---
layout: base.njk
title: Get involved
permalink: /get-involved/
description: "Plan events with us. Volunteer, become a brand ambassador, play our events, or sponsor a night with DC Social Collective."
---
<div class="wrap page-head callout">
  <h1>{{ getinvolved.heading }}</h1>
  <p class="lede">{{ getinvolved.body }}</p>
  <p style="margin-top:1.6rem"><a class="btn" href="/volunteer/">{{ getinvolved.button }}</a></p>
</div>
<section class="band navy callout">
  <div class="wrap">
    <h2>{{ getinvolved.ambassador.heading }}</h2>
    <p class="lede" style="margin:0 auto 1.6rem">{{ getinvolved.ambassador.body }}</p>
    <a class="btn" href="/brand-ambassador/">{{ getinvolved.ambassador.button }}</a>
  </div>
</section>
<section class="band">
  <div class="wrap cards four">
    <article class="card" id="work">
      <h2>{{ getinvolved.work.heading }}</h2>
      <p>{{ getinvolved.work.body }}</p>
      <a class="btn" href="mailto:{{ site.email }}?subject=Hosting%20DSC%20at%20my%20venue">{{ getinvolved.work.button }}</a>
    </article>
    <article class="card">
      <h2>{{ getinvolved.ambassadorCard.heading }}</h2>
      <p>{{ getinvolved.ambassadorCard.body }}</p>
      <a class="btn" href="/brand-ambassador/">{{ getinvolved.ambassadorCard.button }}</a>
    </article>
    <article class="card">
      <h2>{{ getinvolved.music.heading }}</h2>
      <p>{{ getinvolved.music.body }}</p>
      <a class="btn" href="/live-music/">{{ getinvolved.music.button }}</a>
    </article>
    <article class="card">
      <h2>{{ getinvolved.sponsor.heading }}</h2>
      <p>{{ getinvolved.sponsor.body }}</p>
      <a class="btn" href="mailto:{{ site.email }}?subject=Sponsoring%20a%20DSC%20event">{{ getinvolved.sponsor.button }}</a>
    </article>
  </div>
</section>
<section class="band navy" id="social">
  <div class="wrap">
    <h2>{{ getinvolved.social.heading }}</h2>
    <p class="lede" style="margin-bottom:1.6rem">{{ getinvolved.social.body }}</p>
    {%- if getinvolved.social.hashtag %}
    <p class="lede" style="margin-bottom:1.6rem"><strong>{{ getinvolved.social.hashtag }}</strong></p>
    {%- endif %}
    <p style="margin:0"><a class="btn" href="{{ site.instagram }}" rel="noopener">{{ getinvolved.social.button }}</a></p>
  </div>
</section>
<section class="band paper" id="contactus">
  <div class="wrap two-col" style="align-items:start">
    <div>
      <h2>{{ getinvolved.contact.heading }}</h2>
      <p>{{ getinvolved.contact.body }}</p>
      <ul class="contact-lines">
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><a href="tel:{{ site.phone | replace(' ', '') | replace('(', '') | replace(')', '') | replace('-', '') }}">{{ site.phone }}</a></li>
        <li>{{ getinvolved.contact.place }}</li>
      </ul>
    </div>
    <img src="/images/gallery/01.jpg" alt="A packed dance floor at a Sangria y Salsa night" loading="lazy" width="2500" height="1666">
  </div>
</section>
