---
layout: base.njk
title: Videos
permalink: /videos/
description: "Recap videos from DC Social Collective nights: balls, barn dances, salsa nights, and soirees across DC, Maryland, and Virginia."
---
<div class="wrap page-head">
  <h1>Videos</h1>
  <p class="lede">Recaps from our nights, newest first. Turn the sound on.</p>
</div>
<section class="band navy on-dark" style="padding-top:2rem">
  <div class="wrap">
    <div class="band-head videos-head">
      <h2>Reels</h2>
    </div>
    <div class="videos">
    {%- for v in videos %}
      {%- if v.portrait %}
      <figure>
        <div class="video-frame portrait">
          <video controls preload="none" poster="/video/{{ v.slug }}.jpg" width="720" height="1280"><source src="/video/{{ v.slug }}.mp4" type="video/mp4"></video>
        </div>
        <figcaption><strong>{{ v.title }}</strong><br>{{ v.where }}{% if v.credit %}. Video by {{ v.credit }}{% endif %}.</figcaption>
      </figure>
      {%- endif %}
    {%- endfor %}
    </div>

    <div class="band-head videos-head section-gap">
      <h2>Recap Videos</h2>
    </div>
    <div class="videos">
    {%- for v in videos %}
      {%- if not v.portrait %}
      <figure>
        <div class="video-frame">
          <video controls preload="none" poster="/video/{{ v.slug }}.jpg" width="1280" height="720"><source src="/video/{{ v.slug }}.mp4" type="video/mp4"></video>
        </div>
        <figcaption><strong>{{ v.title }}</strong><br>{{ v.where }}{% if v.credit %}. Video by {{ v.credit }}{% endif %}.</figcaption>
      </figure>
      {%- endif %}
    {%- endfor %}
    </div>
  </div>
</section>
