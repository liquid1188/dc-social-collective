---
layout: base.njk
title: Videos
permalink: /videos/
description: "Recap videos from DC Social Collective nights: balls, barn dances, salsa nights, and soirees across DC, Maryland, and Virginia."
---
<div class="wrap page-head">
  <h1>Videos</h1>
  <p class="lede">Recaps and reels from our nights, newest first. Turn the sound on.</p>
</div>
<section class="band navy on-dark" style="padding-top:2rem">
  <div class="wrap">
    <div class="videos">
    {%- for v in videos %}
      {%- set vw = 720 if v.portrait else 1280 %}
      {%- set vh = 1280 if v.portrait else 720 %}
      <figure>
        {#- Reels are shot vertical. They sit in the same 16:9 card as everything
            else, letterboxed over a blurred copy of their own poster. #}
        <div class="video-frame{% if v.portrait %} portrait{% endif %}">
          {%- if v.portrait %}<span class="video-blur" style="background-image:url('/video/{{ v.slug }}.jpg')" aria-hidden="true"></span>{% endif %}
          <video controls playsinline preload="none" poster="/video/{{ v.slug }}.jpg" width="{{ vw }}" height="{{ vh }}"><source src="/video/{{ v.slug }}.mp4" type="video/mp4"></video>
        </div>
        <figcaption><strong>{{ v.title }}</strong><br>{{ v.where }}{% if v.credit %}. Video by {{ v.credit }}{% endif %}.</figcaption>
      </figure>
    {%- endfor %}
    </div>
  </div>
</section>
