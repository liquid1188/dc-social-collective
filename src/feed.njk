---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name }} events</title>
    <link>{{ site.url }}/events/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <description>{{ site.tagline }}</description>
    <language>en-us</language>
    <lastBuildDate>{{ today | rfc822 }}</lastBuildDate>
  {%- for e in collections.feed %}
    <item>
      <title>{{ e.data.title | escape }}</title>
      <link>{{ site.url }}{{ e.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ e.url }}</guid>
      <pubDate>{{ e.date | rfc822 }}</pubDate>
      {%- if e.data.series %}<category>{{ e.data.series | escape }}</category>{% endif %}
      <description>{{ ((e.data | eventBlurb) ~ " " ~ (e.templateContent | striptags | truncate(400))) | escape }}</description>
    </item>
  {%- endfor %}
  </channel>
</rss>
