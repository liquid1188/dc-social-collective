---
layout: base.njk
title: Team
permalink: /team/
description: "The people behind DC Social Collective."
---
<div class="wrap page-head">
  <h1>Meet the team</h1>
  <p class="lede">Crafting timeless experiences, welcoming every newcomer, and handling the details so the evening feels effortless.</p>
</div>
<section class="band" style="padding-top:1.5rem">
  <div class="wrap team">
  {%- for m in team %}
    <article>
      {%- set card = ("/links/" ~ m.slug ~ "/") if m.slug else m.instagram %}
      {%- if card %}
      <a class="headshot" href="{{ card }}"{% if not m.slug %} rel="noopener"{% endif %} title="{{ 'Contact ' ~ m.name if m.slug else m.name ~ ' on Instagram' }}">
        <img src="{{ m.photo }}" alt="{{ m.name }}" width="1000" height="1000" loading="lazy">
        <span class="ig" aria-hidden="true">{% if m.slug %}<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>{% else %}<svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>{% endif %}</span>
      </a>
      <h2><a href="{{ card }}"{% if not m.slug %} rel="noopener"{% endif %}>{{ m.name }}</a></h2>
      {%- else %}
      <img src="{{ m.photo }}" alt="{{ m.name }}" width="1000" height="1000" loading="lazy">
      <h2>{{ m.name }}</h2>
      {%- endif %}
      <p class="role">{{ m.role }}</p>
      {%- if m.slug %}
      <p class="tcontact"><a class="btn small" href="/links/{{ m.slug }}/">Contact {{ m.name.split(" ")[0] }}</a></p>
      {%- endif %}
      <p>{{ m.bio | safe }}</p>
    </article>
  {%- endfor %}
  </div>
</section>
<section class="band paper">
  <div class="wrap">
    <h2>Want to be part of it?</h2>
    <p class="lede">Most of the people who help run these nights started out as guests who kept coming back.</p>
    <a class="btn" href="/get-involved/">Get involved</a>
  </div>
</section>
