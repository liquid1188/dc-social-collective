---
layout: base.njk
title: Press
permalink: /press/
description: "Articles about DC Social Collective, and how to reach us if you are working on a story."
---
<div class="wrap page-head">
  <h1>{{ press.heading }}</h1>
  <p class="lede">{{ press.lede }}</p>
</div>
<section class="band" style="padding-top:1.5rem">
  <div class="wrap">
    <div class="band-head"><h2>{{ press.sectionHeading }}</h2></div>
    <p class="lede" style="margin-top:-1rem">{{ press.sectionLede }}</p>
    <ul class="news">
    {%- for a in press.items %}
      <li>
        <a href="{{ a.url }}" rel="noopener"{% if a.image %} class="withpic"{% endif %}>
          {% if a.image %}<img src="{{ a.image }}" alt="" loading="lazy">{% endif %}
          <div>
          {% set plogo = "" %}{% for l in press.logos %}{% if l.name == a.publication %}{% set plogo = l.logo %}{% endif %}{% endfor %}
          <p class="pub">{% if plogo %}<img class="publogo" src="{{ plogo }}" alt="{{ a.publication }}">{% else %}{{ a.publication }}{% endif %}{% if a.date %}<span class="pubdate">{{ a.date | fullDate }}</span>{% endif %}</p>
          <h3>{{ a.title }}</h3>
          {% if a.summary %}<p class="sum">{{ a.summary }}</p>{% endif %}
          {% if a.byline %}<p class="by">By {{ a.byline }}</p>{% endif %}
          <span class="read">Read the article</span>
          </div>
        </a>
      </li>
    {%- endfor %}
    </ul>
  </div>
</section>
<section class="band paper" id="inquiries">
  <div class="wrap two-col" style="align-items:start">
    <div>
      <h2>{{ press.contactHeading }}</h2>
      <p>{{ press.contactBody }}</p>
      <ul class="contact-lines">
        <li><a href="mailto:{{ site.email }}?subject=Press%20inquiry">{{ site.email }}</a></li>
        <li><a href="tel:{{ site.phone | replace(' ', '') | replace('(', '') | replace(')', '') | replace('-', '') }}">{{ site.phone }}</a></li>
        <li>{{ site.instagram | replace('https://www.instagram.com/', '@') | replace('/', '') }} on Instagram</li>
        {%- if press.contactEmail %}
        <li><a href="mailto:{{ press.contactEmail }}?subject=Press%20inquiry">{{ press.contactEmail }}</a>{% if press.contactName %} · {{ press.contactName }}{% endif %}{% if press.contactRole %}, {{ press.contactRole }}{% endif %}</li>
        {%- endif %}
      </ul>
      {%- if press.logos.length %}
      <div class="pubstrip">
        <p class="eyebrow">{{ press.pressStripHeading }}</p>
        <ul>
        {%- for l in press.logos %}
          <li>{% if l.url %}<a href="{{ l.url }}" rel="noopener">{% endif %}{% if l.logo %}<img src="{{ l.logo }}" alt="{{ l.name }}" loading="lazy">{% else %}{{ l.name }}{% endif %}{% if l.url %}</a>{% endif %}</li>
        {%- endfor %}
        </ul>
      </div>
      {%- endif %}
    </div>
    <img src="/images/gallery/09.jpg" alt="Hundreds of guests at a DSC ball" loading="lazy" width="2500" height="1668">
  </div>
</section>
