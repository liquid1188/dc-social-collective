{%- set digits = m.phone | replace(" ", "") | replace("(", "") | replace(")", "") | replace("-", "") -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ m.name }} · {{ site.name }}</title>
  <meta name="description" content="{{ m.name }}, {{ m.role }} at {{ site.name }}.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/images/favicon.ico?v=3" sizes="16x16 32x32 48x48 64x64">
  <link rel="icon" href="/images/favicon-192.png?v=3" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=3">
  <link rel="preload" as="image" href="/images/team/card/{{ m.slug }}.webp" fetchpriority="high">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {#- Fonts load without holding up the page; system fonts show until they arrive. #}
  {%- set fonts = "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700&family=Work+Sans:wght@400;600&display=swap" %}
  <link rel="preload" as="style" href="{{ fonts }}">
  <link rel="stylesheet" href="{{ fonts }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ fonts }}"></noscript>
  <meta property="og:title" content="{{ m.name }} · {{ site.name }}">
  <meta property="og:description" content="{{ m.role }}">
  <meta property="og:image" content="{{ site.url }}/og/site.jpg">
  <meta property="og:url" content="{{ site.url }}/links/{{ m.slug }}/">
  <link rel="canonical" href="{{ site.url }}/links/{{ m.slug }}/">
  <meta name="theme-color" content="#071a3a">
{%- if site.ga4 %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4 }}"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ site.ga4 }}');</script>
{%- endif %}
  <style>
    :root { --navy:#071a3a; --navy-2:#0c2450; --coral:#f04e49; --coral-dark:#c93a36; --amber:#f2b75b; --cream:#f7f1e6; }
    * { box-sizing: border-box; }
    body { margin:0; min-height:100vh; font-family:"Work Sans",system-ui,sans-serif; color:#fff; background:radial-gradient(120% 70% at 50% 0%, var(--navy-2) 0%, var(--navy) 60%); }
    main { max-width:440px; margin:0 auto; padding:2.2rem 1.25rem 2.5rem; text-align:center; }
    .logo { width:100px; height:auto; display:block; margin:0 auto 1.6rem; }
    .photo { width:148px; height:148px; border-radius:50%; object-fit:cover; display:block; margin:0 auto 1.1rem; border:3px solid var(--coral); }
    h1 { font-family:"Fraunces",Georgia,serif; font-weight:700; font-size:2rem; line-height:1.1; margin:0 0 .45rem; letter-spacing:-.01em; }
    .role { margin:0 0 .3rem; font-size:.82rem; font-weight:600; letter-spacing:.14em; text-transform:uppercase; }
    .rule { width:64px; height:3px; background:var(--coral); border:0; margin:.8rem auto 1.6rem; }
    .links { display:grid; gap:.7rem; }
    .links a { display:flex; align-items:center; justify-content:center; gap:.6rem; min-height:52px; padding:.8rem 1.2rem; border-radius:999px; text-decoration:none; font-weight:600; color:#fff; background:rgba(255,255,255,.08); border:2px solid rgba(255,255,255,.22); transition:background .15s,border-color .15s; }
    .links a:hover { background:rgba(255,255,255,.16); border-color:rgba(255,255,255,.4); }
    .links a.main { background:var(--coral); border-color:var(--coral); }
    .links a.main:hover { background:var(--coral-dark); border-color:var(--coral-dark); }
    .links svg { width:20px; height:20px; flex:none; }
    h2 { font-size:.78rem; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--amber); margin:2.2rem 0 .9rem; }
    .next small { display:block; font-weight:400; font-size:.86rem; opacity:.8; }
    .next { flex-direction:column; gap:.1rem !important; border-radius:22px !important; }
    footer { margin-top:2.4rem; font-size:.8rem; opacity:.6; }
    footer a { color:inherit; }
    :focus-visible { outline:3px solid var(--amber); outline-offset:3px; }
  </style>
</head>
<body>
<main>
  <a href="/"><img class="logo" src="/images/team/card/logo.webp" alt="DC Social Collective" width="200" height="122"></a>
  <img class="photo" src="/images/team/card/{{ m.slug }}.webp" alt="{{ m.name }}" width="148" height="148" fetchpriority="high" decoding="async">
  <h1>{{ m.name }}</h1>
  <p class="role">{{ m.role }}</p>
  <hr class="rule">
  <nav class="links" aria-label="Contact {{ m.name }}">
    <a class="main" href="/links/{{ m.slug }}/contact.vcf" download="{{ m.slug }}.vcf"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>Save contact</a>
    {%- if m.email %}
    <a href="mailto:{{ m.email }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M3 6h18v12H3z"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="m3 7 9 6 9-6"/></svg>Email</a>
    {%- endif %}
    {%- if m.phone %}
    <a href="tel:+1{{ digits }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M6 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z"/></svg>Call {{ m.phone }}</a>
    <a href="sms:+1{{ digits }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 5h16v11H9l-5 4z"/></svg>Text</a>
    {%- endif %}
    {%- if m.instagram %}
    <a href="{{ m.instagram }}" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>Instagram</a>
    {%- endif %}
    {%- if m.facebook %}
    <a href="{{ m.facebook }}" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7h2.4l.4-3h-2.8V9.2c0-.9.3-1.5 1.5-1.5h1.5V5.1c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H8v3h2.6v7z"/></svg>Facebook</a>
    {%- endif %}
  </nav>
  {%- if collections.upcoming.length %}
  <h2>Upcoming events</h2>
  <nav class="links" aria-label="Upcoming events">
  {%- for e in collections.upcoming | head(3) %}
    <a class="main next" href="{{ e.url }}">{{ e.data.title }}<small>{{ e | iso | longDate }}{% if e.data.venue %} · {{ e.data.venue }}{% endif %}</small></a>
  {%- endfor %}
  </nav>
  {%- endif %}
  <h2>DC Social Collective</h2>
  <nav class="links" aria-label="DC Social Collective">
    <a href="{{ site.instagram }}" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>@dcsocialcollective</a>
    {%- if site.facebookPage %}
    <a href="{{ site.facebookPage }}" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7h2.4l.4-3h-2.8V9.2c0-.9.3-1.5 1.5-1.5h1.5V5.1c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H8v3h2.6v7z"/></svg>DSC on Facebook</a>
    {%- endif %}
    <a href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9s1.3-6.4 3.8-9z"/></svg>dcsocialcollective.com</a>
    <a href="/#signup">Join the email list</a>
  </nav>
  <footer>&copy; {{ today | year }} DC Social Collective</footer>
</main>
</body>
</html>
