---
layout: base.njk
permalink: /
description: "Swing, salsa, country nights, and black-tie balls for young adults in DC, Maryland, and Virginia. About 6,000 people a year come out. Find the next night out."
---
{%- set nxt = collections.upcoming[0] %}
<section class="hero on-dark">
  {%- set heroPoster = home.hero.poster or "/images/gallery/17.jpg" %}
  {%- set heroVideo = home.hero.video or "/video/hero.mp4" %}
  <img class="bg" src="{{ heroPoster }}" alt="" width="2500" height="1667" fetchpriority="high">
  <video class="bg" autoplay muted loop playsinline poster="{{ heroPoster }}" aria-hidden="true"><source src="{{ heroVideo }}" type="video/mp4"></video>
  <script>(function(){var v=document.querySelector(".hero video.bg");if(!v)return;function tryPlay(){if(!v.paused)return;var p=v.play&&v.play();if(p&&p.catch)p.catch(function(){v.style.visibility="hidden";});}v.addEventListener("playing",function(){v.style.visibility="";});v.addEventListener("canplay",function(){tryPlay();});tryPlay();window.addEventListener("touchstart",tryPlay,{passive:true});window.addEventListener("scroll",tryPlay,{passive:true});document.addEventListener("visibilitychange",function(){if(!document.hidden)tryPlay();});})();</script>
  <div class="wrap">
    <div>
      <h1>{{ home.hero.headline | replace(home.hero.emphasis, "<em>" + home.hero.emphasis + "</em>") | safe }}</h1>
      <p class="lede">{{ home.hero.lede }}</p>
      <div class="hero-actions">
        <a class="btn" href="{% if nxt %}{{ nxt.url }}{% else %}/events/{% endif %}">{{ home.hero.primary }}</a>
        <a class="btn ghost" href="/about/">{{ home.hero.secondary }}</a>
      </div>
    </div>
    {% if nxt %}
    <a class="next" href="{{ nxt.url }}">
      <img src="{{ nxt.data.image }}" alt="" width="1500" height="750">
      <div class="body">
        <p class="kicker">Next up · {{ nxt | iso | longDate }}</p>
        <h2>{{ nxt.data.title }}</h2>
        <p class="meta">{{ nxt.data.venue }} · <span class="nowrap">{{ nxt.data.time }}{% if nxt.data.end %} to {{ nxt.data.end }}{% endif %}</span></p>
        <span class="btn">Get tickets</span>
      </div>
    </a>
    {% endif %}
  </div>
</section>

<section class="band navy on-dark logos-band" id="featured">
  <div class="wrap">
    <p class="eyebrow">{{ press.logosHeading }}</p>
    <ul class="logos">
    {%- for l in press.logos %}
      <li>{% if l.url %}<a href="{{ l.url }}" rel="noopener">{% endif %}{% if l.logo %}<img src="{{ l.logo }}" alt="{{ l.name }}" loading="lazy"{% if l.h %} style="height:{{ l.h }}px"{% endif %}>{% else %}{{ l.name }}{% endif %}{% if l.url %}</a>{% endif %}</li>
    {%- endfor %}
    </ul>
  </div>
</section>

<section class="band navy on-dark">
  <div class="wrap">
    <div class="band-head"><h2>On the calendar</h2><a href="/events/">All events</a></div>
    <ul class="events">
    {%- for e in collections.upcoming %}
      <li><a href="{{ e.url }}">
        <span class="date">{{ e | iso | shortDate }}<small>{{ e | iso | weekday }} · {{ e.data.time }}</small></span>
        <img class="thumb" src="{{ e.data.image }}" alt="" loading="lazy" width="1500" height="750">
        <span><h3>{{ e.data.title }}</h3><p class="venue">{{ e.data.venue }}</p></span>
      </a></li>
    {%- endfor %}
    </ul>
    <p style="margin-top:1.5rem">These sell out fast. New dates drop on <a href="{{ site.instagram }}" style="color:var(--amber)">Instagram</a> first, or <a href="#signup" style="color:var(--amber)">join the list</a> to get them by email.</p>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="band-head"><h2>Four nights we run back all year</h2></div>
    <div class="series">
      {%- for x in series %}
      <article><a class="series-link" href="/gallery/{{ x.slug }}/"><img src="{{ x.image }}" alt="" loading="lazy"><div class="txt"><h3>{{ x.title }}</h3><p>{{ x.blurb }}</p></div></a></article>
      {%- endfor %}
    </div>
  </div>
</section>

{%- set fv = videos | selectattr("slug", "equalto", home.feature.video) | first %}
{%- if fv %}
<section class="band navy on-dark">
  <div class="wrap">
    <div class="band-head"><h2>{{ home.feature.heading }}</h2></div>
    {%- set fsrc = fv.file or (site.filesBase + "/video/" + fv.slug + ".mp4") %}
    {%- set fposter = fv.poster or ("/video/" + fv.slug + ".jpg") %}
    <video class="feature" controls preload="none" poster="{{ fposter }}" width="1280" height="720"><source src="{{ fsrc }}" type="video/mp4"></video>
    <div class="band-foot split"><p>{{ home.feature.caption }}</p><a href="/videos/">More videos</a></div>
  </div>
</section>
{%- endif %}

<section class="band paper">
  <div class="wrap two-col">
    <img src="/images/gallery/09.jpg" alt="Hundreds of guests at a DSC ball" loading="lazy" width="2500" height="1668">
    <div>
      <h2>{{ home.story.heading }}</h2>
      <p class="lede">{{ home.story.lede }}</p>
      {%- for para in home.story.body.split("\n\n") %}<p>{{ para }}</p>{% endfor %}
      <a class="btn" href="/about/">Read our story</a>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="band-head"><h2>{{ press.homeHeading }}</h2></div>
    <ul class="news three">
    {%- for a in press.items %}{% if loop.index0 < 3 %}
      <li>
        <a href="{{ a.url }}" rel="noopener"{% if a.image %} class="withpic"{% endif %}>
          {% if a.image %}<img src="{{ a.image }}" alt="" loading="lazy">{% endif %}
          <div>
          {% set plogo = "" %}{% for l in press.logos %}{% if l.name == a.publication %}{% set plogo = l.logo %}{% endif %}{% endfor %}
          <p class="pub">{% if plogo %}<img class="publogo" src="{{ plogo }}" alt="{{ a.publication }}">{% else %}{{ a.publication }}{% endif %}{% if a.date %}<span class="pubdate">{{ a.date | fullDate }}</span>{% endif %}</p>
          <h3>{{ a.title }}</h3>
          <span class="read">Read the article</span>
          </div>
        </a>
      </li>
    {%- endif %}{% endfor %}
    </ul>
    <div class="band-foot"><a href="/press/">{{ press.homeLink }}</a></div>
  </div>
</section>

<section class="band navy on-dark">
  <div class="wrap">
    <div class="band-head"><h2>From the dance floor</h2></div>
    <div class="mosaic">
      <a href="/gallery/"><img src="/images/gallery/04.jpg" alt="A packed dance floor at The Winery at Bull Run" loading="lazy"></a>
      <a href="/gallery/"><img src="/images/gallery/07.jpg" alt="Guests in 1920s dress" loading="lazy"></a>
      <a href="/gallery/"><img src="/images/gallery/21.jpg" alt="Friends at a ball" loading="lazy"></a>
      <a href="/gallery/"><img src="/images/gallery/14.jpg" alt="A dance under stage fog" loading="lazy"></a>
      <a href="/gallery/"><img src="/images/gallery/11.jpg" alt="Country dancing" loading="lazy"></a>
    </div>
    <div class="band-foot split"><p class="share-note">{{ instagram.share | replace("@" + instagram.handle, '<a href="' + site.instagram + '" rel="noopener">@' + instagram.handle + '</a>') | safe }}</p><a href="/gallery/">All photos</a></div>
    <div class="quotes">
    {%- for q in quotes.items %}
      <blockquote>
        <p>“{{ q.quote }}”</p>
        <cite>{% if q.url and not q.source %}<a href="{{ q.url }}" rel="noopener">{{ q.who }}</a>{% else %}{{ q.who }}{% endif %}{% if q.role %}, {{ q.role }}{% endif %}{% if q.source %}, in {% if q.url %}<a href="{{ q.url }}" rel="noopener">{{ q.source }}</a>{% else %}{{ q.source }}{% endif %}{% endif %}</cite>
      </blockquote>
    {%- endfor %}
    </div>
  </div>
</section>

<section class="band venues-band" id="venues">
  <div class="wrap">
    <div class="band-head"><h2>{{ venues.heading }}</h2></div>
    <p class="lede" style="margin-top:-1rem">{{ venues.lede }}</p>
    <div class="venues-wrap">
    <ul class="venues top">
    {%- for v in venues.items %}{% if loop.index <= 5 %}
      <li class="{{ v.font }} {{ v.tone }} {{ v.cls }}" title="{{ v.name }}">{% if v.url %}<a href="{{ v.url }}" rel="noopener">{% endif %}{% if v.logo %}<img src="{{ v.logo }}" alt="{{ v.name }}" loading="lazy">{% else %}<span class="vtext">{{ v.name }}</span>{% endif %}<span class="vname">{{ v.name }}</span>{% if v.url %}</a>{% endif %}</li>
    {%- endif %}{% endfor %}
    </ul>
    <ul class="venues">
    {%- for v in venues.items %}{% if loop.index > 5 %}
      <li class="{{ v.font }} {{ v.tone }} {{ v.cls }}" title="{{ v.name }}">{% if v.url %}<a href="{{ v.url }}" rel="noopener">{% endif %}{% if v.logo %}<img src="{{ v.logo }}" alt="{{ v.name }}" loading="lazy">{% else %}<span class="vtext">{{ v.name }}</span>{% endif %}<span class="vname">{{ v.name }}</span>{% if v.url %}</a>{% endif %}</li>
    {%- endif %}{% endfor %}
    </ul>
    </div>
  </div>
</section>
<section class="band paper">
  <div class="wrap">
    <div class="band-head"><h2>Our brand ambassadors</h2><a href="/team/">Meet the whole team</a></div>
    <div class="ambassadors">
      {%- for m in team %}{% if m.role == "Brand Ambassador" %}
      <a class="amb" href="{{ m.instagram or '/team/' }}"{% if m.instagram %} rel="noopener"{% endif %}>
        <img src="{{ m.photo }}" alt="{{ m.name }}" width="1000" height="1000" loading="lazy">
        <div><h3>{{ m.name }}</h3><p class="role">Brand Ambassador</p><p>{{ m.bio | truncate(160) }}</p></div>
      </a>
      {% endif %}{% endfor %}
      <div class="amb join">
        <div><h3>Ambassadors started as regulars.</h3><p>They represent DSC at events and online, welcome the people who came alone, and help set the tone of the room. We add a few a year.</p><a class="btn" href="/brand-ambassador/">Become an ambassador</a></div>
      </div>
    </div>
  </div>
</section>



<section class="band dusk-merch">
  <div class="wrap merch">
    <div>
      <h2>Wear the collective.</h2>
      <p class="lede">Tees, hats, and hoodies with the DSC mark, shipped to you.</p>
      <a class="btn" href="/merch/">Shop the merch</a>
    </div>
    <img src="/images/merch-hoodie.jpg" alt="The DSC logo hoodie in green" loading="lazy" width="1000" height="1000">
  </div>
</section>
{%- if partners.items | length %}
{#- The logo is a black wordmark on transparency, so this band stays on paper:
    on the navy it all but disappears. #}
<section class="band paper partner-band">
  <div class="wrap partner">
    <div>
      <p class="eyebrow">Who we work with</p>
      <h2>{{ partners.heading }}</h2>
      <p class="lede">{{ partners.lede }}</p>
    </div>
    <div class="partner-logos">
    {%- for p in partners.items %}
      <a class="partner-logo" href="{{ p.url }}" target="_blank" rel="noopener">
        <img src="{{ p.logo }}" alt="{{ p.name }}" loading="lazy" width="900" height="48">
        <span>{{ p.role }} &middot; {{ partners.linkLabel }} &rarr;</span>
      </a>
    {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}
<section class="band" id="signup">
  <div class="wrap signup">
    <div>
      <h2>Get the date before it sells out.</h2>
      <p>One email when a night is announced, one when early bird pricing is about to end. That's it.</p>
    </div>
    {%- if home.signupEmbed %}
      <div class="embedded-form">{{ home.signupEmbed | safe }}</div>
      {%- else %}
<form action="/api/subscribe" method="POST">
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
      <input type="text" name="first" placeholder="First name" required aria-label="First name">
      <input type="text" name="last" placeholder="Last name" aria-label="Last name">
      <input type="email" name="email" placeholder="Email address" required aria-label="Email address">
      <button class="btn" type="submit">Sign me up</button>
    </form>
      {%- endif %}
  </div>
</section>
