  {%- if credit %}<p class="tally">Photos by {{ credit }}</p>{% endif %}
</div>
<section class="band" style="padding-top:1.5rem">
  <div class="wrap gallery">
  {%- for im in images %}
    <figure>
      <a href="{{ im.full }}"><img src="{{ im.thumb }}" alt=""{% if im.w %} width="{{ im.w }}" height="{{ im.h }}"{% endif %} loading="{% if loop.index0 < 6 %}eager{% else %}lazy{% endif %}" decoding="async"></a>
      <a class="dl" href="{{ im.download }}" download="{{ im.name }}" title="Download this photo" aria-label="Download this photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14"/></svg></a>
    </figure>
  {%- endfor %}
  </div>
</section>
<script>
// A plain download attribute is ignored across domains, and the imported albums
// still sit on the Squarespace CDN. That CDN sends access-control-allow-origin,
// so fetch the file and hand the browser a blob instead. If anything fails, the
// link opens the photo as it did before.
(function () {
  var gallery = document.querySelector(".gallery");
  if (!gallery || !window.fetch) return;
  var exts = { "image/jpeg": "jpg", "image/png": "png", "image/webp": "webp", "image/gif": "gif", "image/avif": "avif" };
  function fileNameFor(url, blob) {
    var base = (url.split("?")[0].split("/").pop() || "photo").replace(/\.[a-z0-9]+$/i, "");
    return decodeURIComponent(base) + "." + (exts[blob.type] || "jpg");
  }
  function fetchBlob(url) {
    return fetch(url).then(function (response) {
      if (!response.ok) throw new Error(response.status);
      return response.blob();
    });
  }
  // iOS Safari has no download attribute, so hand the file to the system
  // share sheet instead: one tap on the photo or the download icon pops up
  // Save Image / Save to Files, no long-press needed.
  if (!("download" in document.createElement("a"))) {
    gallery.addEventListener("click", function (event) {
      var anchor = event.target.closest && event.target.closest("a");
      if (!anchor || !gallery.contains(anchor)) return;
      event.preventDefault();
      var url = anchor.getAttribute("href");
      fetchBlob(url).then(function (blob) {
        try {
          var file = new File([blob], fileNameFor(url, blob), { type: blob.type });
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            return navigator.share({ files: [file] }).catch(function () {
              window.open(url, "_blank", "noopener");
            });
          }
        } catch (e) { /* fall through to a new tab */ }
        window.open(url, "_blank", "noopener");
      }).catch(function () {
        window.open(url, "_blank", "noopener");
      });
    });
    return;
  };
  gallery.addEventListener("click", function (event) {
    var chip = event.target.closest && event.target.closest("a.dl");
    if (!chip || chip.dataset.busy) return;
    event.preventDefault();
    var url = chip.getAttribute("href");
    chip.dataset.busy = "1";
    fetchBlob(url).then(function (blob) {
      var href = URL.createObjectURL(blob);
      var link = document.createElement("a");
      link.href = href;
      link.download = fileNameFor(url, blob);
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(function () { URL.revokeObjectURL(href); }, 2000);
    }).catch(function () {
      window.open(url, "_blank", "noopener");
    }).then(function () {
      delete chip.dataset.busy;
    });
  });
})();
</script>
