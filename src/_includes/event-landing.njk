---
layout: base.njk
---
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Event","name":"{{ title }}","startDate":"{{ page.date | isoDate | truncate(10, true, '') }}","eventStatus":"https://schema.org/EventScheduled","location":{"@type":"Place","name":"{{ venue }}","address":"{{ address }}"},"organizer":{"@type":"Organization","name":"DC Social Collective","url":"{{ site.url }}"},"image":"{{ site.url }}{{ image }}"{% if tickets %},"offers":{"@type":"Offer","url":"{{ tickets }}"}{% endif %}}</script>
<div class="wrap page-head">
  <p style="margin:0 0 .5rem"><a href="/events/" style="color:var(--coral-dark);text-decoration:none;font-weight:600">All events</a></p>
  <h1>{{ title }}</h1>
  <p class="lede">{{ page.date | isoDate | truncate(10, true, '') | longDate }}, {{ page.date | isoDate | truncate(4, true, '') }}{% if time %} · <span class="nowrap">{{ time }}{% if end %} to {{ end }}{% endif %}</span>{% endif %} · {{ venue }}</p>
</div>
<section class="band" style="padding-top:1.5rem">
  <div class="wrap event-page">
    <div class="landing-main">
      {%- macro pair(photos) %}{% if photos and photos.length %}
      <div class="img-pair">{% for ph in photos %}
        <img src="{{ ph.src }}" alt="{{ ph.alt }}" width="1600" height="1067" loading="lazy">{% endfor %}
      </div>{% endif %}{% endmacro %}
      {%- macro block(s) %}
      <div class="prose">
        {% if s.heading %}<h2>{{ s.heading }}</h2>{% endif %}
        {% if s.image %}<img src="{{ s.image }}" alt="{{ s.imageAlt }}" width="1600" height="1067" loading="lazy" style="border-radius:12px;margin-bottom:1rem">{% endif %}
        {{ s.text | md | safe }}
      </div>
      {{ pair(s.photos) }}{% endmacro %}
      {% set dISO = page.date | isoDate | truncate(10, true, '') %}
      {% if flyer %}
      <figure class="landing-hero">
        <img src="{{ flyer }}" alt="{{ flyerAlt or (title ~ ' flyer') }}" width="1215" height="1519" fetchpriority="high">
      </figure>
      {% endif %}

      {% if promoVideo %}
      <div class="event-promo event-promo-inline">
        <div class="event-promo-card">
          <video class="feature portrait" controls preload="none"{% if promoPoster %} poster="{{ promoPoster }}"{% endif %} width="720" height="1280"><source src="{{ promoVideo }}" type="video/mp4"></video>
          <div>
            <p class="eyebrow">{{ venue }}</p>
            <h2>{{ promoHeading or "See the night before you go" }}</h2>
            {% if promoText %}<p class="lede">{{ promoText }}</p>{% endif %}
            {% if tickets and dISO >= today %}<a class="btn" href="#book">Get tickets</a>{% endif %}
          </div>
        </div>
      </div>
      {% endif %}

      {% set before = sections or [] %}
      {% for s in before %}{% if loop.first and highlightsBlock !== false %}{{ block(s) }}
      <div class="prose">
        <h2>Event Highlights</h2>
        <ul>
          <li>{{ dISO | longDate }}{% if time %}, {{ time }}{% if end %} to {{ end }}{% else %} to late{% endif %}{% endif %}</li>
          <li>{{ venue }}{% if address %}, {{ address }}{% endif %}</li>
          {% if earlyBirdDay and earlyBirdDay >= today %}<li>Early-bird pricing{% if earlyBirdPrice %}: {{ earlyBirdPrice }}{% endif %}, until {{ earlyBirdDay | fullDate }}{% if earlyBirdTime %} at {{ earlyBirdTime }}{% endif %}. After that, prices go up.</li>{% endif %}
          {% for h in highlights or [] %}<li>{{ h }}</li>{% endfor %}
        </ul>
      </div>
      {% else %}{{ block(s) }}{% endif %}{% endfor %}

      {% if schedule and schedule.length %}
      <div class="prose">
        <h2>Schedule <span style="font-weight:400;font-size:1rem;color:var(--ink-2)">(Subject to Change)</span></h2>
        <ul>{% for row in schedule %}
          <li><strong>{{ row.time }}</strong> – {{ row.what }}</li>{% endfor %}
        </ul>
      </div>
      {% endif %}

      {% for s in after or [] %}{{ block(s) }}{% endfor %}

      <div class="prose">
        <h2>Questions?</h2>
        <p>Email us at <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
      {% include "consent.njk" %}

      {% if presentedBy %}
      <figure class="presented-by">
        <img src="{{ presentedBy }}" alt="{{ presentedByAlt or 'Presented by' }}" width="1200" height="630" loading="lazy">
      </figure>
      {% endif %}
    </div>

    <aside class="facts">
      <dl>
        <dt>Where</dt><dd>{{ venue }}{% if address %}<br><span style="color:var(--ink-2)">{{ address }}</span>{% endif %}<br><a href="{{ venue | mapUrl(address) }}" style="font-size:.9rem">Open in Maps</a></dd>
        {% if time %}<dt>When</dt><dd>{{ time }}{% if end %} to {{ end }}{% endif %}</dd>{% endif %}
        {% if series %}<dt>Series</dt><dd>{{ series }}</dd>{% endif %}
        {% if earlyBirdDay and earlyBirdDay >= today %}<dt>Early bird</dt><dd>Until {{ earlyBirdDay | fullDate }}{% if earlyBirdTime %} at {{ earlyBirdTime }}{% endif %}</dd>{% endif %}
      </dl>
      {% set today_s = today %}
      {% set d = page.date | isoDate | truncate(10, true, '') %}
      {% if tickets and d >= today_s %}<a class="btn" href="#book" style="width:100%;text-align:center">Get tickets</a>
      <a href="{{ { date: d, title: title, venue: venue, address: address, time: time, end: end, url: site.url ~ page.url } | gcalUrl }}" target="_blank" rel="noopener" style="display:block;text-align:center;margin-top:.8rem;font-size:.95rem">Add to Google Calendar</a>
      {% elif d < today_s %}{% set alb = collections.albums | albumForEvent({ date: d, album: album }) %}<p style="margin:0;color:var(--ink-2)">This night has happened. {% if alb %}<a href="{{ alb.url }}">See the photos from this night</a>{% else %}<a href="/gallery/">See the photos</a>{% endif %} or <a href="/events/">find the next one</a>.</p>{% endif %}
    </aside>
  </div>
</section>
{%- if tickets and d >= today_s %}
<section class="band book-photo" id="book">
  <div class="wrap">
    <h2>Get your tickets</h2>
    <div class="booking-start">
      <p>{{ page.date | isoDate | truncate(10, true, '') | longDate }} at {{ venue }}{% if time %}, {{ time }}{% endif %}. Tickets are handled on this page.</p>
      <button class="btn" type="button" data-src="{{ tickets | embedUrl }}" data-title="Tickets for {{ title }}">Get tickets for this night</button>
      <noscript><a class="btn" href="{{ tickets }}" target="_blank" rel="noopener">Get tickets</a></noscript>
    </div>
    <script>
    // The form only loads once somebody asks for it, so nobody lands on a
    // ticket form for a night they have not chosen, and the page does not pull
    // a third party frame it may never need.
    (function () {
      var start = document.currentScript.previousElementSibling;
      var button = start && start.querySelector("button");
      if (!button) return;
      var opened = false;
      var warmed = false;
      // Open the connection to the ticket host as soon as somebody looks like
      // they are about to press, so the frame is not starting from a cold DNS
      // lookup and TLS handshake when they do.
      function warm() {
        if (warmed) return;
        warmed = true;
        try {
          var link = document.createElement("link");
          link.rel = "preconnect";
          link.href = new URL(button.dataset.src, location.href).origin;
          link.crossOrigin = "";
          document.head.appendChild(link);
        } catch (e) { /* nothing to warm */ }
      }
      ["pointerenter", "touchstart", "focus"].forEach(function (ev) {
        button.addEventListener(ev, warm, { passive: true });
      });
      function open(behavior) {
        if (opened) return;
        opened = true;
        var host = document.createElement("div");
        host.className = "booking-host is-loading";
        host.innerHTML = '<div class="booking-wait" role="status"><span class="booking-spin" aria-hidden="true"></span><p>Loading tickets\u2026</p></div>';
        var frame = document.createElement("iframe");
        frame.className = "booking";
        frame.src = button.dataset.src;
        frame.title = button.dataset.title;
        frame.setAttribute("allow", "payment");
        // RSVPify paints nothing for a beat, so keep the placeholder up until
        // the frame says it has loaded rather than showing a white rectangle.
        frame.addEventListener("load", function () { host.classList.remove("is-loading"); });
        host.appendChild(frame);
        start.replaceWith(host);
        host.scrollIntoView({ block: "start", behavior: behavior });
      }
      button.addEventListener("click", function () { open("smooth"); });
      // Landing on #book means Get tickets was already pressed somewhere else,
      // on the events list or in the sidebar, so do not ask for a second press.
      if (location.hash === "#book") open("auto");
      window.addEventListener("hashchange", function () {
        if (location.hash === "#book") open("smooth");
      });
    })();
    </script>
  </div>
</section>
<a class="btn float-tickets" href="#book">Get tickets</a>
<script>
(function () {
  var btn = document.querySelector(".float-tickets");
  var book = document.getElementById("book");
  if (!btn) return;
  function onScroll() {
    var past = window.scrollY > 600;
    var bookVisible = false;
    if (book) {
      var r = book.getBoundingClientRect();
      bookVisible = r.top < window.innerHeight && r.bottom > 0;
    }
    btn.classList.toggle("show", past && !bookVisible);
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
})();
</script>
{%- endif %}
