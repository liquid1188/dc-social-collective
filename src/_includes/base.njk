<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  {% if site.setupMode %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,500&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v={{ buildId }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="{{ site.url }}/images/gallery/17.jpg">
</head>
<body{% if page.url == "/" %} class="home"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="DC Social Collective home"><img src="/images/logo.png" alt="DC Social Collective" width="600" height="600"></a>
    <input type="checkbox" id="menu" class="menu-toggle" aria-label="Open menu">
    <label for="menu" class="menu-btn"><span></span><span></span></label>
    <nav class="nav" aria-label="Main">
      <a href="/events/"{% if '/events' in page.url %} aria-current="page"{% endif %}>Events</a>
      <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
      <a href="/gallery/"{% if page.url == '/gallery/' %} aria-current="page"{% endif %}>Photos</a>
      <a href="/team/"{% if page.url == '/team/' %} aria-current="page"{% endif %}>Team</a>
      <a href="/get-involved/"{% if page.url == '/get-involved/' %} aria-current="page"{% endif %}>Get involved</a>
      <a href="{{ site.merch }}">Merch</a>
      <a class="btn small" href="/events/">Tickets</a>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-foot v2">
  <div class="wrap foot-top">
    <div class="fbrand">
      <img class="fmark" src="/images/logo.png" alt="" width="600" height="600" loading="lazy"><p class="foot-brand">DC Social Collective</p>
      
      <p class="foot-tag">Premier social events for young adults in DC, Maryland, and Virginia. Over {{ site.members }} members.</p>
      <div class="foot-ctas"><a class="btn" href="/events/">Get tickets</a><a class="btn ghost" href="/#signup">Join the list</a></div>
    </div>
    <div class="fcol"><h3>Come along</h3><a href="/events/">Upcoming events</a><a href="/events/#past">Past events</a><a href="/gallery/">Photos</a><a href="/about/#faq">Questions</a></div><div class="fcol"><h3>More</h3><a href="/get-involved/">Get involved</a><a href="/get-involved/#sponsor">Sponsor an event</a><a href="{{ site.merch }}">Shop merch</a><a href="/team/">The team</a><a href="/about/">About DSC</a><a href="/donate/">Donate</a></div>
    <div class="fcol fcontact">
      <h3>Find us</h3>
      <a class="crow" href="mailto:{{ site.email }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3 6h18v12H3z"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="m3 7 9 6 9-6"/></svg><span>{{ site.email }}</span></a><a class="crow" href="tel:{{ site.phone | replace(' ', '') | replace('(', '') | replace(')', '') | replace('-', '') }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M6 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z"/></svg><span>{{ site.phone }}</span></a><span class="crow"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg><span>Washington, DC</span></span>
      <div class="socials"><a class="soc" href="{{ site.instagram }}" aria-label="Instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg></a><a class="soc" href="{{ site.facebook }}" aria-label="Facebook group" title="Facebook group"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7h2.4l.4-3h-2.8V9.2c0-.9.3-1.5 1.5-1.5h1.5V5.1c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H8v3h2.6v7z"/></svg></a></div>
    </div>
  </div>
  
  <div class="wrap foot-bottom">
    <span class="copy">&copy; {{ today | year }} DC Social Collective. Live sound and lighting by <a href="https://www.redlinerentalsva.com/">Red Line Rentals</a>.</span>
    <span class="util"><a href="/admin/">Sign in</a><a href="https://lickitysplitweb.com">Site by Lickity Split Web Design</a><a class="totop" href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false" aria-label="Back to top"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="m6 14 6-6 6 6"/></svg></a></span>
  </div>
</footer>
</body>
</html>
