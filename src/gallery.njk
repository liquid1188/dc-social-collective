---
layout: base.njk
title: Photos
permalink: /gallery/
description: "Every DC Social Collective night in photos, since the first picnic in 2021."
---
<div class="wrap page-head">
  <h1>Photos</h1>
  <p class="lede">Every night since the first picnic in 2021, newest first.</p>
  <p class="tally">{{ collections.albums | length }} galleries &middot; {{ collections.albums | photoCount }} photos</p>
</div>
{%- if instagram.beholdFeedId or instagram.embed %}
<section class="band paper" id="instagram" style="padding-top:1.5rem">
  <div class="wrap">
    <div class="band-head"><h2>{{ instagram.heading }}</h2><a href="{{ site.instagram }}" rel="noopener">@{{ instagram.handle }}</a></div>
    <div class="ig-feed">
    {%- if instagram.beholdFeedId %}
      <behold-widget feed-id="{{ instagram.beholdFeedId }}"></behold-widget>
      <script>
        (() => {
          if(window.__bhldScript)return;window.__bhldScript=true;
          const d=document,s=d.createElement("script");s.type="module";
          s.src="https://w.behold.so/widget.js";setTimeout(()=>{d.head.append(s);},0);
        })();
      </script>
    {%- else %}
      {{ instagram.embed | safe }}
    {%- endif %}
    </div>
  </div>
</section>
{%- endif %}
<section class="band" style="padding-top:1.5rem">
  <div class="wrap"><div class="band-head"><h2>Photo gallery</h2></div></div>
  <div class="wrap albums">
  {%- for a in collections.albums %}
    <a class="album" href="{{ a.url }}">
      {% if a.data.coverImage %}<img src="{{ a.data.coverImage }}" alt="" loading="{% if loop.index0 < 6 %}eager{% else %}lazy{% endif %}">{% endif %}
      <div><h2>{{ a.data.title }}</h2><p>{{ a.data.day | fullDate }}</p><p class="tally">{{ a.data.photos | length }} photos</p></div>
    </a>
  {%- endfor %}
  </div>
</section>
